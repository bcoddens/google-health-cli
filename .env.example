# Copy to .env and fill in values. .env is gitignored — never commit real secrets.

# Project identity used by scripts/sonar-scan.sh, scripts/sonar-duplications.sh,
# and scripts/sonar-create-project.sh.
SONAR_PROJECT_KEY=google-health-cli
SONAR_PROJECT_NAME="Google Health CLI"

# SonarQube analysis token. If unset here, the scripts fall back to resolving
# SONAR_OP_REF (default: op://Private/SonarQube/api_key) via the 1Password CLI
# (`op`) — see scripts/lib/1password.sh.
SONAR_TOKEN=

# Optional: SonarQube host, if not the default local server.
# SONAR_HOST=http://localhost:9000

# Optional: a Browse/Create-Projects-capable user token. Recommended for
# scripts/sonar-create-project.sh and required for new-code issue detail and
# exact duplicate block cross-references. SONAR_TOKEN suffices for scanning.
# SONAR_ADMIN_TOKEN=
